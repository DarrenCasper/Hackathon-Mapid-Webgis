generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Station {
  id         String        @id
  name       String
  region     String
  location   Unsupported("geometry(Point, 4326)")

  // Rough line-adjacency reference, not authoritative KAI schedule data —
  // "which station is next/before this one on the map," picked as a
  // single primary neighbor per direction. At junction stations (e.g.
  // Manggarai, where the Bogor line and Bekasi line branch), this can't
  // represent every real direction — it's a simplification the project
  // owner explicitly accepted in place of a full multi-directional
  // adjacency table. Nullable: line termini have no next_station, and
  // this is left null for any station where "next" isn't picked yet.
  prev_station_id String?
  next_station_id String?
  prev_station     Station? @relation("StationPrev", fields: [prev_station_id], references: [id])
  next_station     Station? @relation("StationNext", fields: [next_station_id], references: [id])
  prev_of          Station[] @relation("StationPrev")
  next_of          Station[] @relation("StationNext")

  // Phase 9 — AI-generated "what to expect" recommendation text.
  // Deliberately pre-generated and cached, NOT produced live per
  // request: with 90 stations, generating once (or on an explicit
  // admin-triggered regenerate) is a small, fixed, predictable cost.
  // A public route that called Claude on every page view would have no
  // natural rate limit and could run up API spend from ordinary
  // traffic, let alone abuse.
  ai_insight             String?
  ai_insight_generated_at DateTime?

  exits      StationExit[]
  isochrones Isochrone[]
  reports    Report[]
}

model StationExit {
  id         Int      @id @default(autoincrement())
  station_id String
  station    Station  @relation(fields: [station_id], references: [id])
  label      String
  location   Unsupported("geometry(Point, 4326)")
}

model Isochrone {
  id           Int      @id @default(autoincrement())
  station_id   String
  station      Station  @relation(fields: [station_id], references: [id])
  minutes      Int
  polygon      Unsupported("geometry(Polygon, 4326)")
  method       String   @default("valhalla")
  generated_at DateTime @default(now())

  @@unique([station_id, minutes])
}

enum PoiCategory {
  kopi_minuman
  quick_meal
  warung_makan
  bakery
  casual_dining
  hiburan
}

enum PriceTier {
  ekonomis
  menengah
  premium
}

enum PoiSource {
  mapid_missions
  openstreetmap
  // Real government open data (e.g. satudata.jakarta.go.id) — distinct
  // from 'openstreetmap' because it genuinely comes from a different
  // place with different provenance/reliability characteristics
  // (official municipal records vs. community mapping), and distinct
  // from 'mock' because it's real, not placeholder data. Mislabeling
  // this as either would misrepresent where it actually came from.
  jakarta_opendata
  mock
}

model MapidMission {
  id             String   @id
  mission_type   String
  location       Unsupported("geometry(Point, 4326)")
  raw_properties Json
  poi_id         Int?
  poi            Poi?     @relation(fields: [poi_id], references: [id])
  ingested_at    DateTime @default(now())
}

model MapidActivity {
  id                String    @id
  title             String?
  description       String?
  location          Unsupported("geometry(Point, 4326)")
  media_urls        String[]
  user_name         String?
  user_full_name    String?
  community_name    String?
  total_comment     Int?
  likes_count       Int?
  source_created_at DateTime?
  raw_properties    Json
  poi_id            Int?
  poi               Poi?      @relation(fields: [poi_id], references: [id])
  ingested_at       DateTime  @default(now())
}

model Poi {
  id                Int             @id @default(autoincrement())
  name              String
  // Nullable, unlike the original brief's schema: resolve-pois.js creates
  // Poi rows before classify-categories.js has run, so there's no
  // category yet at creation time; price_tier has no populating script
  // at all yet. NULL means "not yet classified" — Phase 4 routes need to
  // handle that explicitly, not assume every Poi has both set.
  category          PoiCategory?
  price_tier        PriceTier?
  location          Unsupported("geometry(Point, 4326)")
  source            PoiSource       @default(mock)
  verified_field    Boolean         @default(false)
  menu_utama        String?
  harga_rata_rata   Int?
  jam_buka          String?
  jam_tutup         String?
  kondisi_tempat    String?
  raw_category_text String?

  // Phase 9 change-detection: lets the daily insight-refresh job ask
  // "has this station's data actually changed since its insight was
  // last generated" instead of blindly regenerating all 90 stations
  // every day. NOT using Prisma's @updatedAt here — that annotation
  // only fires on writes made through Prisma Client, and nearly every
  // write to this table across this project goes through $executeRaw
  // (resolve-pois.js, fetch-osm-fallback.js, fetch-jakarta-opendata.js,
  // classify-categories.js) because of the geometry column. A DB-level
  // trigger (see migration 20260823120000_poi_timestamps) sets
  // updated_at on every UPDATE regardless of which script performs it,
  // so nothing needs to remember to set this by hand.
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  missions          MapidMission[]
  activities        MapidActivity[]
  reports           Report[]
}

model Moderator {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  display_name  String
  created_at    DateTime @default(now())
  reports       Report[] @relation("ModeratedBy")
}

enum ReportType {
  trotoar_rusak
  akses_tertutup
  banjir
  penyeberangan_tidak_aman
  tempat_tutup
  umkm_baru
  info_lainnya
}

enum ReportStatus {
  pending
  verified
  rejected
  applied
}

model Report {
  id             String       @id @default(uuid())
  station_id     String
  station        Station      @relation(fields: [station_id], references: [id])
  poi_id         Int?
  poi            Poi?         @relation(fields: [poi_id], references: [id])
  report_type    ReportType
  description    String
  photo_url      String?
  status         ReportStatus @default(pending)
  moderator_id   String?
  moderator      Moderator?   @relation("ModeratedBy", fields: [moderator_id], references: [id])
  moderator_note String?
  created_at     DateTime     @default(now())
  resolved_at    DateTime?
}
