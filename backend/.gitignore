.env
node_modules/

# Valhalla's OSM extract (.pbf) and the routing tiles it builds from it —
# large binary files, never commit these. You'll need to re-download the
# extract on any fresh machine per README.md "Valhalla setup".
valhalla/

# Generated by scripts/generate-verify-page.js — has the real
# MAPID_API_KEY inline in a URL. verify/map-check.template.html (the
# key-free version) is what's committed.
verify/map-check.local.html
