# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# PostgreSQL + PostGIS connection string.
# This points at a database that ALREADY EXISTS and is ALREADY RUNNING —
# it's a Coolify-managed resource on the server, not something this project
# starts itself. Format: postgres://user:password@host:port/dbname
DATABASE_URL="postgres://user:password@host:5432/transitfit"

# Competition API key for MAPID's Missions and Activities endpoints.
# Same key is used for both server.mapid.io/web/competition/{propertigo,menugo,struckgo}
# and server.mapid.io/web/competition/activities.
MAPID_API_KEY="your-mapid-competition-api-key"

# Secret used to sign moderator JWTs (Phase 5). Any long random string —
# generate one with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET="replace-with-a-long-random-string"

# Base URL of the local Valhalla routing container (see docker-compose.yml).
# Default port for the gis-ops/docker-valhalla image is 8002.
VALHALLA_URL="http://localhost:8002"

# Port the Express API listens on locally. Coolify sets its own PORT at
# deploy time (see README "Coolify deployment" section) — this is only
# for local dev.
PORT=3000
