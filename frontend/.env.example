# Lihat frontend.md §4 untuk penjelasan lengkap tiap variabel.

# Base URL backend TransitFit AI (lihat guide.md di root repo)
VITE_API_BASE_URL=https://mapidapi.darrencasper.com/api

# Basemap MAPID — key sama dengan yang dipakai backend (MAPID_API_KEY di backend/.env)
VITE_MAPID_API_KEY=

# OpenStreetService (ORS) — untuk garis rute jalan kaki di peta, lihat frontend.md §10.
# Daftar gratis di https://openrouteservice.org/dev/#/signup. Kosongkan untuk
# fallback ke garis lurus.
VITE_ORS_API_KEY=
