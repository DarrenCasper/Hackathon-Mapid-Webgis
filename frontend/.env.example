# Lihat frontend.md §4 untuk penjelasan lengkap tiap variabel.

# Base URL backend TransitFit AI (lihat guide.md di root repo)
VITE_API_BASE_URL=

# Basemap MAPID — key sama dengan yang dipakai backend (MAPID_API_KEY di backend/.env)
VITE_MAPID_API_KEY=

# Rute A* dijalankan di browser; sumber graf OVERPASS_URL dikonfigurasi pada backend.
# Semua VITE_* bersifat publik. Jangan isi dengan rahasia server.
